{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/actor-profile.schema.json",
  "title": "Threat Actor Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "name",
    "status",
    "created_at",
    "updated_at",
    "actor",
    "attribution",
    "motivations",
    "relationships",
    "associated_entities",
    "entity_relationships",
    "hunting_pivots",
    "diamond_model",
    "capabilities",
    "activities",
    "victim_cases",
    "targets",
    "ttps",
    "sources",
    "assessment",
    "free_text"
  ],
  "properties": {
    "schema_version": {"const": "1.4.0"},
    "profile_id": {"type": "string", "pattern": "^actor--[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "published", "deprecated"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "languages": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "aliases", "actor_types", "first_seen", "last_seen", "active", "description", "analyst_notes"],
      "properties": {
        "canonical_name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
        "actor_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "first_seen": {"$ref": "#/$defs/timePoint"},
        "last_seen": {"$ref": "#/$defs/timePoint"},
        "active": {"enum": ["yes", "no", "unknown"]},
        "description": {"type": "string"},
        "analyst_notes": {"type": "string"}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countries", "sponsor_type", "organizations", "assessment", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "countries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sponsor_type": {"enum": ["state", "state-aligned", "criminal", "hacktivist", "private-sector-offensive", "unknown"]},
        "organizations": {"type": "array", "items": {"$ref": "#/$defs/namedEntity"}},
        "assessment": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "motivations": {"type": "array", "items": {"$ref": "#/$defs/motivation"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "associated_entities": {"type": "array", "items": {"$ref": "#/$defs/associatedEntity"}},
    "entity_relationships": {"type": "array", "items": {"$ref": "#/$defs/entityRelationship"}},
    "hunting_pivots": {"type": "array", "items": {"$ref": "#/$defs/huntingPivot"}},
    "diamond_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adversary", "capability", "infrastructure", "victim", "socio_political", "analyst_notes"],
      "properties": {
        "adversary": {"type": "string"},
        "capability": {"type": "string"},
        "infrastructure": {"type": "string"},
        "victim": {"type": "string"},
        "socio_political": {"type": "string"},
        "analyst_notes": {"type": "string"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["malware", "tools", "infrastructure", "delivery_formats", "vulnerabilities", "operational_capabilities", "analyst_notes"],
      "properties": {
        "malware": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "tools": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "infrastructure": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "delivery_formats": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "vulnerabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "operational_capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "analyst_notes": {"type": "string"}
      }
    },
    "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "victim_cases": {"type": "array", "items": {"$ref": "#/$defs/victimCase"}},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countries", "regions", "sectors", "roles", "selection_logic", "analyst_notes"],
      "properties": {
        "countries": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "regions": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "sectors": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "selection_logic": {"type": "string"},
        "analyst_notes": {"type": "string"}
      }
    },
    "ttps": {"type": "array", "items": {"$ref": "#/$defs/ttp"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_judgments", "gaps", "uncertainties", "collection_notes", "analyst_notes"],
      "properties": {
        "key_judgments": {"type": "array", "items": {"$ref": "#/$defs/judgment"}},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "uncertainties": {"type": "array", "items": {"type": "string"}},
        "collection_notes": {"type": "string"},
        "analyst_notes": {"type": "string"}
      }
    },
    "free_text": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["executive_summary", "history", "capability_details", "infrastructure_details", "targeting_details", "additional_notes"],
      "properties": {
        "executive_summary": {"type": "string"},
        "history": {"type": "string"},
        "capability_details": {"type": "string"},
        "infrastructure_details": {"type": "string"},
        "targeting_details": {"type": "string"},
        "additional_notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "referenceArray": {"type": "array", "items": {"type": "string", "pattern": "^source--"}, "uniqueItems": true},
    "timePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "precision", "status", "basis"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "precision": {"enum": ["second", "day", "month", "year", "range", "unknown"]},
        "status": {"enum": ["known", "inferred", "unknown"]},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vendor", "scope", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string"},
        "scope": {"enum": ["exact", "overlapping", "broader", "narrower", "unknown"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "namedEntity": {
      "type": "object",
      "required": ["id", "name", "relationship", "confidence", "evidence_refs"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "relationship": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "motivation": {
      "type": "object",
      "required": ["type", "description", "confidence", "evidence_refs"],
      "properties": {
        "type": {"type": "string"},
        "description": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "relationship": {
      "type": "object",
      "required": ["relationship_id", "target_actor", "relationship_type", "description", "confidence", "evidence_refs"],
      "properties": {
        "relationship_id": {"type": "string", "pattern": "^relationship--"},
        "target_actor": {"type": "string"},
        "relationship_type": {"type": "string"},
        "description": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "first_observed": {"$ref": "#/$defs/timePoint"},
        "last_observed": {"$ref": "#/$defs/timePoint"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "associatedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "name", "entity_type", "aliases", "description", "countries", "roles", "threat_actor_types", "first_observed", "last_observed", "legal_actions", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^(organization|threat-actor-group|threat-actor-individual)--[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "entity_type": {"enum": ["organization", "threat-actor-group", "threat-actor-individual"]},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "description": {"type": "string"},
        "countries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "threat_actor_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "first_observed": {"$ref": "#/$defs/timePoint"},
        "last_observed": {"$ref": "#/$defs/timePoint"},
        "legal_actions": {"type": "array", "items": {"$ref": "#/$defs/legalAction"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "legalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "action_type", "authority", "action_date", "status", "description", "evidence_refs", "analyst_notes"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^legal-action--"},
        "action_type": {"enum": ["indictment", "charge", "sanction", "arrest", "conviction", "sentencing", "wanted", "other"]},
        "authority": {"type": "string"},
        "action_date": {"$ref": "#/$defs/timePoint"},
        "status": {"enum": ["alleged", "pending", "completed", "unknown"]},
        "description": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "entityRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "source_ref", "target_ref", "relationship_type", "description", "first_observed", "last_observed", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "relationship_id": {"type": "string", "pattern": "^entity-relationship--"},
        "source_ref": {"type": "string"},
        "target_ref": {"type": "string"},
        "relationship_type": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "first_observed": {"$ref": "#/$defs/timePoint"},
        "last_observed": {"$ref": "#/$defs/timePoint"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "huntingPivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pivot_id", "category", "pivot_type", "value", "description", "stix_pattern", "attribution_scope", "malware_refs", "infrastructure_refs", "activity_refs", "indicator_refs", "observations", "first_observed", "last_observed", "observation_count", "source_count", "activity_count", "continuity", "hunt_queries", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "pivot_id": {"type": "string", "pattern": "^hunting-pivot--"},
        "category": {"enum": ["infrastructure", "malware", "identity", "behavior"]},
        "pivot_type": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "stix_pattern": {"type": ["string", "null"]},
        "attribution_scope": {"enum": ["actor-specific", "shared", "generic", "unknown"]},
        "malware_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "infrastructure_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "activity_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "indicator_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/pivotObservation"}},
        "first_observed": {"$ref": "#/$defs/timePoint"},
        "last_observed": {"$ref": "#/$defs/timePoint"},
        "observation_count": {"type": "integer", "minimum": 0},
        "source_count": {"type": "integer", "minimum": 0},
        "activity_count": {"type": "integer", "minimum": 0},
        "continuity": {"$ref": "#/$defs/pivotContinuity"},
        "hunt_queries": {"type": "array", "items": {"$ref": "#/$defs/huntQuery"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "pivotObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "observed_at", "source_ref", "activity_ref", "context", "count", "count_basis"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^pivot-observation--"},
        "observed_at": {"$ref": "#/$defs/timePoint"},
        "source_ref": {"type": "string", "pattern": "^source--"},
        "activity_ref": {"type": ["string", "null"]},
        "context": {"type": "string"},
        "count": {"type": "integer", "minimum": 1},
        "count_basis": {"enum": ["documented-events", "documented-samples", "documented-hosts", "documented-observables", "minimum-events", "source-stated", "unknown"]}
      }
    },
    "pivotContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "active_status", "evaluated_at", "basis", "passive_scan_performed", "checks"],
      "properties": {
        "assessment": {"enum": ["reused", "reobserved", "historical-only", "single-observation", "unknown"]},
        "active_status": {"enum": ["active", "inactive", "unknown"]},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "basis": {"type": "string"},
        "passive_scan_performed": {"type": "boolean"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/continuityCheck"}}
      }
    },
    "continuityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "evaluated_at", "platform", "query", "index_or_time_window", "result_count", "result_summary", "analyst_validated", "evidence_refs", "limitations"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^continuity-check--"},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "platform": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "index_or_time_window": {"type": "string"},
        "result_count": {"type": ["integer", "null"], "minimum": 0},
        "result_summary": {"type": "string"},
        "analyst_validated": {"type": "boolean"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "limitations": {"type": "string", "minLength": 1}
      }
    },
    "huntQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "query", "purpose", "requires_validation", "false_positive_notes"],
      "properties": {
        "platform": {"enum": ["shodan", "censys", "file-intelligence", "edr", "siem", "other"]},
        "query": {"type": "string", "minLength": 1},
        "purpose": {"type": "string"},
        "requires_validation": {"const": true},
        "false_positive_notes": {"type": "string", "minLength": 1}
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "name", "description", "first_observed", "last_observed", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "types": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"},
        "first_observed": {"$ref": "#/$defs/timePoint"},
        "last_observed": {"$ref": "#/$defs/timePoint"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "activity": {
      "type": "object",
      "required": ["activity_id", "name", "activity_type", "stix_object_type", "grouping_context", "activity_refs", "first_observed", "last_observed", "reported_at", "description", "target_refs", "malware_refs", "infrastructure_refs", "ttp_refs", "victim_refs", "diamond_model", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "activity_id": {"type": "string", "pattern": "^activity--"},
        "name": {"type": "string"},
        "activity_type": {"type": "string"},
        "stix_object_type": {"enum": ["campaign", "incident", "grouping"]},
        "grouping_context": {
          "enum": ["suspicious-activity", "malware-analysis", "unspecified", null]
        },
        "activity_refs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^activity--"},
          "uniqueItems": true
        },
        "first_observed": {"$ref": "#/$defs/timePoint"},
        "last_observed": {"$ref": "#/$defs/timePoint"},
        "reported_at": {"$ref": "#/$defs/timePoint"},
        "description": {"type": "string"},
        "target_refs": {"type": "array", "items": {"type": "string"}},
        "malware_refs": {"type": "array", "items": {"type": "string"}},
        "infrastructure_refs": {"type": "array", "items": {"type": "string"}},
        "ttp_refs": {"type": "array", "items": {"type": "string"}},
        "victim_refs": {"type": "array", "items": {"type": "string"}},
        "diamond_model": {"$ref": "#/$defs/activityDiamond"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "activityDiamond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adversary", "capability", "infrastructure", "victim", "meta_features", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "adversary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_ref", "name", "attribution_countries", "organization_refs"],
          "properties": {
            "actor_ref": {"type": "string", "pattern": "^actor--"},
            "name": {"type": "string"},
            "attribution_countries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "organization_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["malware_refs", "ttp_refs"],
          "properties": {
            "malware_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "ttp_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "infrastructure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["infrastructure_refs"],
          "properties": {
            "infrastructure_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "victim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_refs", "victim_refs"],
          "properties": {
            "target_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "victim_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "meta_features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_observed", "last_observed", "reported_at", "activity_type", "phases", "results", "direction"],
          "properties": {
            "first_observed": {"$ref": "#/$defs/timePoint"},
            "last_observed": {"$ref": "#/$defs/timePoint"},
            "reported_at": {"$ref": "#/$defs/timePoint"},
            "activity_type": {"type": "string"},
            "phases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "results": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "direction": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_countries", "target_country_refs", "target_region_refs"],
              "properties": {
                "source_countries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "target_country_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "target_region_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              }
            }
          }
        },
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "victimCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["victim_case_id", "name", "victim_name", "disclosure_status", "victim_type", "case_status", "description", "activity_refs", "target_refs", "malware_refs", "ttp_refs", "affected_assets", "impacts", "first_observed", "last_observed", "reported_at", "confidence", "evidence_refs", "analyst_notes"],
      "properties": {
        "victim_case_id": {"type": "string", "pattern": "^victim--"},
        "name": {"type": "string"},
        "victim_name": {"type": ["string", "null"]},
        "disclosure_status": {"enum": ["named", "anonymous", "aggregate", "unknown"]},
        "victim_type": {"enum": ["organization", "person", "multiple-organizations", "multiple-persons", "mixed", "unknown"]},
        "case_status": {"enum": ["confirmed", "reported", "alleged", "disputed", "unknown"]},
        "description": {"type": "string"},
        "activity_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "target_refs": {"type": "array", "items": {"type": "string"}},
        "malware_refs": {"type": "array", "items": {"type": "string"}},
        "ttp_refs": {"type": "array", "items": {"type": "string"}},
        "affected_assets": {"type": "array", "items": {"type": "string"}},
        "impacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["impact_type", "description"],
            "properties": {
              "impact_type": {"enum": ["data-theft", "credential-theft", "financial-loss", "encryption", "destruction", "disruption", "espionage", "account-compromise", "privacy", "supply-chain", "unknown", "other"]},
              "description": {"type": "string"}
            }
          }
        },
        "first_observed": {"$ref": "#/$defs/timePoint"},
        "last_observed": {"$ref": "#/$defs/timePoint"},
        "reported_at": {"$ref": "#/$defs/timePoint"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"},
        "analyst_notes": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["id", "name", "description", "first_observed", "last_observed", "confidence", "evidence_refs"],
