    {
      "activity_id": "activity--daily-2c3e99f982af03e6e5ab",
      "name": "Salt Typhoon、JumbledPathマルウェアを使用して米国の通信ネットワークをスパイ",
      "activity_type": "cyber-espionage",
      "first_observed": {
        "value": null,
        "precision": "unknown",
        "status": "unknown",
        "basis": "not-stated"
      },
      "last_observed": {
