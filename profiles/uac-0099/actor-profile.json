    {
      "activity_id": "activity--daily-72da5dad97e2e21f550f",
      "name": "ハッカーがNotepad++プラグインを悪用し、密かにマルウェアをインストール",
      "activity_type": "malware-campaign",
      "first_observed": {
        "value": null,
        "precision": "unknown",
        "status": "unknown",
        "basis": "not-stated"
      },
      "last_observed": {
        "value": null,
