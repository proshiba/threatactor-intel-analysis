    {
      "type": "infrastructure",
      "spec_version": "2.1",
      "id": "infrastructure--13e19a0e-7ab9-4f04-82f8-1308bfccfc53",
      "created": "2026-08-21T01:36:26Z",
      "modified": "2026-08-21T01:36:26Z",
      "object_marking_refs": [
        "marking-definition--94868c89-83c2-464b-929b-a1a8aa3c8487"
      ],
      "name": "ファイル共有を装うOAuthフィッシングドメインとクラウドプロジェクト",
      "description": "UNC5976はファイル共有を思わせる名称のドメインを購入し、対応するクラウドプロジェクトを作成する。ドメインは偽のファイル共有ページを提供し、数秒後にログインダイアログを表示する。標的が認証すると、認証トークンをURLから取得して保存する悪性スクリプトを設置したクラウドプロジェクトのURLへリダイレクトされる。GTIGによる初回の発見と無効化からおよそ3か月のうちに、少なくとも12件の新規ドメインと関連インフラが作成された。GTIGは、UNC5976がフィッシングインフラの一部をGoogle以外の事業者へ移行しつつあると評価している。",
      "external_references": [
        {
          "source_name": "Google Threat Intelligence Group",
          "description": "Local source: https://cloud.google.com/blog/topics/threat-intelligence/distinct-clusters-target-individuals-of-interest-to-russia",
          "external_id": "source--gtig-going-with-the-flows-2026"
        }
      ],
      "x_profile_object_id": "infra--unc5976-file-sharing-phishing-domains",
      "x_confidence": "high",
      "x_analyst_notes": "原文は12件の新規ドメインの個別値を列挙していないため、IOCとして収録できるのはIOC表に掲載された2件のみである。",
      "infrastructure_types": [
        "phishing-domain",
        "cloud-project"
      ]
    },
