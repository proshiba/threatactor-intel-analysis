                "https://www.microsoft.com/en-us/security/blog/2024/02/14/staying-ahead-of-threat-actors-in-the-age-of-ai/",
                "https://apt.etda.or.th/cgi-bin/showcard.cgi?g=APT+4%2C+Maverick+Panda%2C+Wisp+Team&n=1"
              ],
              "related": []
            },
            {
              "entry_uuid": "32e28369-30a3-4675-8e0a-04c91c1def98",
              "entry_value": "Samurai Panda",
              "external_id": null,
