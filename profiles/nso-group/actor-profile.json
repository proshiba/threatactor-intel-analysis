      "name": "NSOグループ、1,400人のWhatsAppユーザーへのスパイウェア攻撃で1億6,700万ドルの罰金",
      "activity_type": "cyber-espionage",
      "first_observed": {
        "value": null,
        "precision": "unknown",
        "status": "unknown",
        "basis": "not-stated"
      },
      "last_observed": {
