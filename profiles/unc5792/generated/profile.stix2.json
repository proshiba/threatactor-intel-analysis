  "objects": [
    {
      "type": "intrusion-set",
      "spec_version": "2.1",
      "id": "intrusion-set--329b530f-5406-4876-8d55-59134707a6ae",
      "created": "2026-09-10T22:21:37Z",
      "modified": "2026-09-10T22:21:37Z",
      "object_marking_refs": [
        "marking-definition--94868c89-83c2-464b-929b-a1a8aa3c8487"
      ],
      "name": "UNC5792",
      "aliases": [],
      "description": "ロシアを拠点とする脅威クラスタ。FBIとCISAの共同PSAは、Signalのバックアップ復旧キーを狙うフィッシング活動が「UNC5792およびUNC4221として公に追跡されている」と記載する。GTIGは別途、本クラスタがAIモデルを自動監視ボットへ組み込み、ロシア当局の関心事項の観点からTelegramチャンネルを解析していると報告している。メッセージングアプリの利用者アカウントとチャンネル情報の収集に一貫した関心を示す。",
      "goals": [
        "政府・軍関係者、政治家、ジャーナリスト、ウクライナの重要人物を対象に、暗号化メッセージングアプリ上の過去の会話内容を取得する。",
        "ロシア当局が関心を持つ治安上の脅威や過激派コンテンツの観点から、Telegramチャンネルを継続的に監視・分類する。"
      ],
      "external_references": [
        {
          "source_name": "Federal Bureau of Investigation / Cybersecurity and Infrastructure Security Agency",
          "description": "Local source: https://www.ic3.gov/PSA/2026/PSA260626",
          "external_id": "source--fbi-cisa-psa-signal-recovery-keys-2026"
        },
        {
          "source_name": "Google Threat Intelligence Group",
          "description": "Local source: https://cloud.google.com/blog/topics/threat-intelligence/from-prompting-to-autonomy-the-evolution-of-adversarial-ai",
          "external_id": "source--gtig-adversarial-ai-2026"
        }
      ],
      "x_profile_id": "actor--unc5792",
      "x_alias_assessments": [],
      "x_attribution": {
        "countries": [
          "Russia"
        ],
        "sponsor_type": "state-aligned",
        "organizations": [],
        "assessment": "GTIGは2026-09-08の報告で本クラスタを「UNC5792—a Russia-based threat group」と記述する。FBI・CISAの共同PSA(2026-06-26)は、Signalの復旧キーを狙う当該フィッシング活動をロシア情報機関に関連するものとして警告し、「To date, this activity has been publicly tracked as UNC5792 and UNC4221.」と述べる。PSAは追跡名を付与した組織を明示していない。特定の政府機関への所属を確定する記述は、確認したいずれの資料にもない。",
        "confidence": "medium",
        "evidence_refs": [
          "source--fbi-cisa-psa-signal-recovery-keys-2026",
          "source--gtig-adversarial-ai-2026"
        ],
        "analyst_notes": "GTIGの「Russia-based」は拠点の記述であって国家支援の確定ではない。PSAはロシア情報機関関連の活動として警告するが、UNC5792という指定子と特定機関の対応は述べていない。sponsor_typeはstate-alignedとし、state-sponsoredとは区別する。"
      },
      "x_free_text": {
        "executive_summary": "UNC5792はロシアを拠点とする脅威クラスタで、暗号化メッセージングアプリ利用者の通信内容取得を目的とする活動が観測されている。FBIとCISAの共同PSAは、Signalのサポート窓口を装って復旧キーを詐取し過去の会話を閲覧する手口を警告し、この活動がUNC5792およびUNC4221として公に追跡されていると述べる。GTIGは別途、AIモデルを組み込んだ自動ボットでTelegramチャンネルを解析し、ロシア当局の関心事項に沿う情報を構造化報告として出力させる試みを報告している。",
        "history": "FBI・CISAは2026年3月に最初の告知を行い、2026-06-26のPSA(I-062626-PSA)でこれを更新した。GTIGは2026-09-08のAI脅威報告で、AIを組み込んだTelegram監視の事例として本クラスタを取り上げている。",
        "capability_details": "確認できている能力はマルウェアではなく運用手法である。サポート窓口を装うソーシャルエンジニアリングにより、検証コード、アカウントPIN、バックアップ復旧キーを詐取する。復旧キーは攻撃者端末でのバックアップ復元を可能にし、過去の個人・グループ会話へのアクセスを与える。監視面ではTelegramボットにAIモデルを組み込み、メッセージの分類と報告生成を自動化している。",
        "infrastructure_details": "公開されたインフラ指標はない。確認したいずれの資料もIOCを掲載していない。",
        "targeting_details": "構造化ターゲット監査: 標的国=ウクライナ、米国。標的地域=広域情報なし。日本は確認時に個別国として保持する。\n\n標的は現職および元職の米国・各国政府関係者、軍関係者、政治家、ジャーナリスト、およびウクライナの重要人物である。Telegram監視では、ロシア当局が関心を持つ治安上の脅威や過激派コンテンツが対象とされる。帰属国であるロシアは標的国として扱わない。",
        "additional_notes": "本プロファイルは2026-09-10の日次チェックで未帰属クラスタ台帳から昇格したものであり、status は draft から開始する。profiles/unc4221 との統合は行っていない。"
      }
    },
