    {
      "activity_id": "activity--daily-c535922b3c89d69acd5c",
      "name": "Microsoftプラットフォームを悪用してマルウェアに署名していたサイバー犯罪サービスが妨害される",
      "activity_type": "disruptive-activity",
      "first_observed": {
        "value": null,
