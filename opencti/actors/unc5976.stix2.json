      ],
      "name": "UNC7005",
      "aliases": [
        "STORM-2945"
      ],
      "description": "UNC7005はGoogle Threat Intelligence Group (GTIG)が2026年2月に特定した、認証フローの悪用に重点を置くロシア関連の脅威クラスタである。Microsoftの呼称ではSTORM-2945にあたる。app passwordフィッシング、MicrosoftおよびWhatsAppのデバイスコードフィッシング、OAuthフィッシングを組み合わせ、インフォスティーラーの配布も行う。GTIGは「we assess with moderate confidence that UNC7005 is another initial access cluster connected to ICE RELIC」と評価する一方、UNC6293とは「lower sophistication and poor operational security, infrastructure with divergent characteristics, and incorporation of malware」を理由に別クラスタとして追跡している。2026年7月に表面化した宿泊施設・会議施設のcaptive portalリダイレクト作戦のインフラも本クラスタへ結び付けられている。",
      "x_profile_id": "actor--unc7005",
      "x_profile_status": "draft",
      "created_by_ref": "identity--bd43e677-a948-44f1-863a-2f1fe0e14560",
      "first_seen": "2026-02-01T00:00:00Z",
      "last_seen": "2026-08-13T00:00:00Z"
    },
    {
      "type": "intrusion-set",
      "spec_version": "2.1",
      "id": "intrusion-set--65ac951c-67ab-4bf7-9ad1-ec22a6dc8d54",
      "created": "2026-08-21T01:36:26Z",
      "modified": "2026-09-21T02:39:41Z",
      "object_marking_refs": [
        "marking-definition--94868c89-83c2-464b-929b-a1a8aa3c8487"
      ],
      "name": "UNC5976",
      "aliases": [],
      "description": "UNC5976はGoogle Threat Intelligence Group (GTIG)が2026年3月からOAuth関連活動の追跡を開始した、認証に重点を置くロシア関連の諜報クラスタである。GTIGは「We believe this cluster to be distinct from UNC6293 and UNC7005」と述べ、ICE RELIC(旧APT29)へ結び付く2クラスタとは別のものとして扱っている。ファイル共有を思わせるドメインとクラウドプロジェクトを組み合わせたOAuthフィッシングによる認証トークンの自動収集を主な手口とし、悪性のExcelプラグインHEADRUSHも用いる。",
      "first_seen": "2026-03-01T00:00:00Z",
      "last_seen": "2026-04-01T00:00:00Z",
      "goals": [
        "GTIGはUNC5976を「a suspected Russian cyber espionage cluster with an authentication focus」と説明し、認証トークンの窃取によるアカウント侵害を目的とする活動と位置付けている。"
      ],
      "external_references": [
        {
          "source_name": "Google Threat Intelligence Group",
          "description": "Local source: https://cloud.google.com/blog/topics/threat-intelligence/distinct-clusters-target-individuals-of-interest-to-russia",
          "external_id": "source--gtig-going-with-the-flows-2026",
          "url": "https://cloud.google.com/blog/topics/threat-intelligence/distinct-clusters-target-individuals-of-interest-to-russia"
        }
      ],
      "x_profile_id": "actor--unc5976",
      "x_profile_status": "draft",
      "x_alias_assessments": [],
      "x_attribution": {
        "countries": [
          "Russia"
        ],
        "sponsor_type": "state",
        "organizations": [],
        "assessment": "GTIGは「GTIG assesses with high confidence that these three threat clusters - UNC6293, UNC7005, and UNC5976 - possess a Russian nexus, based on high-level targeting patterns, phishing themes, and shared operational techniques」とhigh confidenceでロシア関連性を評価している。UNC5976については「a suspected Russian cyber espionage cluster with an authentication focus」と記述し、ICE RELIC系の2クラスタとは区別したうえで「potentially reflecting differing strategic mandates and potential alignment with alternative Russian intelligence services」と述べるにとどまり、具体的な機関への帰属は行っていない。",
        "confidence": "medium",
        "evidence_refs": [
          "source--gtig-going-with-the-flows-2026"
        ],
        "analyst_notes": "国レベルの帰属はGTIGがhigh confidenceで述べるが、sponsor_typeを含むattributionブロック全体としてはmediumとする。「alternative Russian intelligence services」への整合は可能性の指摘であり、organizationsへは反映しない。"
      },
      "x_free_text": {
        "executive_summary": "UNC5976はGTIGが2026年3月から追跡する、認証に重点を置くロシア関連の諜報クラスタである。ファイル共有を装うドメインとクラウドプロジェクトを組み合わせたOAuthフィッシングで認証トークンを自動収集し、悪性Excelプラグイン HEADRUSH も用いる。GTIGはUNC6293・UNC7005とは別クラスタと評価している。",
        "history": "2026年3月にGTIGがOAuth関連活動の追跡を開始し、無効化後およそ3か月で少なくとも12件の新規ドメインが再構築された。2026年4月にはHEADRUSH検体の配布が確認された。",
        "capability_details": "OAuthフィッシングでは、正規のGoogle OAuthログイン画面を経由させたうえで攻撃者管理のクラウドプロジェクトへリダイレクトし、URLから認証トークンを取得して保存する。HEADRUSHは悪性のExcelプラグインで、最終的にHTAダウンローダーへ到達する。",
        "infrastructure_details": "購入ドメインは多くがファイル共有に関連する名称を用いる。GTIGは、フィッシングインフラの一部がGoogle以外の事業者へ移行しつつあると評価している。",
        "targeting_details": "構造化ターゲット監査: 標的国=アルメニア、ウクライナ。標的地域=広域情報なし。日本は確認時に個別国として保持する。\n\nHEADRUSHの配布ではウクライナの研究機関を装うドメインが用いられ、ウクライナの航空宇宙・画像関連企業が標的となった可能性がある。",
        "additional_notes": "2026-08-21の日次チェックで、GTIG「Going with the Flow(s)」(2026-08-20)を唯一の一次資料として新規作成した。独立した一次資料が追加された時点でstatusの見直しを行う。"
      },
      "x_osint_crosscheck_assessment": "no-match",
      "created_by_ref": "identity--bd43e677-a948-44f1-863a-2f1fe0e14560"
    },
