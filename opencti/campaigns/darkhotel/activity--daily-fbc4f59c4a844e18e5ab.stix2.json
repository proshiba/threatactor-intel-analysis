    {
      "type": "campaign",
      "spec_version": "2.1",
      "id": "campaign--e0714d92-9eea-4b5b-b83d-9e422d6c6942",
      "created": "2026-08-18T02:14:58Z",
      "modified": "2026-09-21T04:35:02Z",
